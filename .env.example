# Shared with the Seller Hub app — same MongoDB database.
MARKETPLACE_URL=https://makinithome.in
SITE_URL=https://makinithome.in
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=areebadesignco
CURRENCY_SYMBOL=₹
PLACEHOLDER_IMAGE_URL=none
SEO_OG_IMAGE=https://res.cloudinary.com/dtiy0aqwb/image/upload/v1786108031/home_umbrvg.png

# --- AI (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Media storage (Amazon S3, media written by the Seller Hub) ---
AWS_S3_BUCKET=atlas-claret-kettle
AWS_REGION=eu-north-1
AWS_S3_PREFIX=makerly
AWS_S3_PUBLIC_BASE=https://atlas-claret-kettle.s3.eu-north-1.amazonaws.com

# --- Sessions ---
# Random 32+ char string. Falls back to MONGODB_URI if unset — set this
# explicitly in production so rotating the DB connection string doesn't also
# invalidate every signed-in session.
SESSION_SECRET=

# --- Google Sign-In ---
# Same Google OAuth client ID in both — GOOGLE_CLIENT_ID is used server-side
# to verify the ID token; VITE_GOOGLE_CLIENT_ID is the public copy the
# browser needs to render the button (Google client IDs are not secret).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Phone OTP (Twilio) ---
# Phone sign-in is temporarily disabled in the UI (see AuthDialog.tsx /
# PHONE_AUTH_ENABLED). These are only needed once it's switched back on —
# without them, requestPhoneOtp() still works but returns the code directly
# instead of sending an SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Payments (Razorpay) ---
# Checkout refuses to place a paid order until both are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
